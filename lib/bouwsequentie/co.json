nts=\"479.8,278.2 522.0,302.6 522.0,301.0 479.8,276.6\" fill=\"#470020\"/><polygon points=\"529.7,305.3 522.8,309.3 522.8,298.9 529.7,294.9\" fill=\"#5E1229\"/><line x1=\"526.3\" y1=\"307.3\" x2=\"526.3\" y2=\"296.9\" stroke=\"#2E0016\" stroke-width=\"0.5\" opacity=\".55\"/><line x1=\"488.3\" y1=\"269.4\" x2=\"530.5\" y2=\"293.8\" stroke=\"#FFFFFF\" stroke-width=\"0.7\" opacity=\".55\"/><line x1=\"488.3\" y1=\"269.4\" x2=\"479.8\" y2=\"274.3\" stroke=\"#FFFFFF\" stroke-width=\"0.7\" opacity=\".4\"/>","plan":"<polygon points=\"437.0,247.8 483.8,274.8 466.9,284.6 420.1,257.6\" fill=\"none\" stroke=\"#7E7268\" stroke-width=\"1\" stroke-dasharray=\"3 2.5\"/><polygon points=\"488.3,282.2 530.5,306.6 522.0,311.5 479.8,287.1\" fill=\"none\" stroke=\"#7E7268\" stroke-width=\"1\" stroke-dasharray=\"3 2.5\"/>","plotmark":"<line x1=\"340.0\" y1=\"40.0\" x2=\"340.0\" y2=\"34.0\" stroke=\"#8A7F76\" stroke-width=\"1.0\"/><polygon points=\"340.0,32.2 343.1,34.0 340.0,35.8 336.9,34.0\" fill=\"#B4433F\"/><line x1=\"700.3\" y1=\"248.0\" x2=\"700.3\" y2=\"242.0\" stroke=\"#8A7F76\" stroke-width=\"1.0\"/><polygon points=\"700.3,240.2 703.4,242.0 700.3,243.8 697.1,242.0\" fill=\"#B4433F\"/><line x1=\"450.8\" y1=\"392.0\" x2=\"450.8\" y2=\"386.0\" stroke=\"#8A7F76\" stroke-width=\"1.0\"/><polygon points=\"450.8,384.2 454.0,386.0 450.8,387.8 447.7,386.0\" fill=\"#B4433F\"/><line x1=\"90.6\" y1=\"184.0\" x2=\"90.6\" y2=\"178.0\" stroke=\"#8A7F76\" stroke-width=\"1.0\"/><polygon points=\"90.6,176.2 93.7,178.0 90.6,179.8 87.5,178.0\" fill=\"#B4433F\"/><polygon points=\"340.0,40.0 700.3,248.0 450.8,392.0 90.6,184.0\" fill=\"none\" stroke=\"#5E5349\" stroke-width=\"1.4\"/><line x1=\"80.2\" y1=\"190.0\" x2=\"440.5\" y2=\"398.0\" stroke=\"#6E625B\" stroke-width=\"0.9\"/><line x1=\"83.0\" y1=\"188.4\" x2=\"77.4\" y2=\"191.6\" stroke=\"#6E625B\" stroke-width=\"0.9\"/><line x1=\"443.2\" y1=\"396.4\" x2=\"437.7\" y2=\"399.6\" stroke=\"#6E625B\" stroke-width=\"0.9\"/><text class=\"t t-dim\" x=\"251.5\" y=\"299.1\">104 m</text><line x1=\"710.6\" y1=\"254.0\" x2=\"461.2\" y2=\"398.0\" stroke=\"#6E625B\" stroke-width=\"0.9\"/><line x1=\"713.4\" y1=\"255.6\" x2=\"707.9\" y2=\"252.4\" stroke=\"#6E625B\" stroke-width=\"0.9\"/><line x1=\"464.0\" y1=\"399.6\" x2=\"458.5\" y2=\"396.4\" stroke=\"#6E625B\" stroke-width=\"0.9\"/><text class=\"t t-dim\" x=\"594.8\" y=\"331.1\">72 m</text>","dims":"<line x1=\"395.4\" y1=\"236.0\" x2=\"412.7\" y2=\"246.0\" stroke=\"#6E625B\" stroke-width=\"0.9\"/><line x1=\"398.2\" y1=\"234.4\" x2=\"392.7\" y2=\"237.6\" stroke=\"#6E625B\" stroke-width=\"0.9\"/><line x1=\"415.5\" y1=\"244.4\" x2=\"410.0\" y2=\"247.6\" stroke=\"#6E625B\" stroke-width=\"0.9\"/><text class=\"t t-dim\" x=\"413.0\" y=\"235.9\">Bestaande aansluiting</text>","labels":"<text class=\"t t-blk\" x=\"411.0\" y=\"241.0\">Blok 1</text><text class=\"t t-sub\" x=\"411.0\" y=\"251.4\">5 MW / 20 MWh</text>","hits":"<polygon class=\"hit h-cont\" points=\"437.0,232.6 488.0,262.0 466.9,274.2 415.9,244.8\" data-t=\"Batterijcluster, 4 units\" data-b=\"Vier containers van 20 voet tegen elkaar en gespiegeld, elk 5 MWh in twaalf clusters. LFP 314 Ah, vloeistofgekoeld. Samen 20 MWh op een fundatie.\"/><polygon class=\"hit h-stat\" points=\"488.3,267.0 534.6,293.8 522.0,301.1 475.7,274.3\" data-t=\"Conversiestation, 10 MVA\" data-b=\"40 voet met acht omvormers van 1250 kVA, de transformator en de middenspanningsinstallatie in een behuizing. Schakelinstallatie SF6-vrij.\"/>"},"fasen":{"1":"<div class=\"phase-meta\"><span class=\"phase-num\">01</span><span class=\"phase-dur\">Uitgangssituatie</span></div>\n      <h2>Een park dat wordt afgeregeld</h2>\n      <p>Het zonnepark levert meer terug dan de aansluiting aankan. Op heldere dagen in het voorjaar zit het tegen de grens en wordt het afgeregeld, precies op de uren dat de opbrengst het hoogst zou zijn. Die verloren productie is de eerste post in de businesscase van een batterij op dezelfde aansluiting.</p>\n      <dl class=\"role\"><dt>Gridstate</dt><dd>Wij lezen de meetdata uit, kwantificeren het opbrengstverlies per uur en rekenen door wat een batterij toevoegt aan de kasstroom.</dd></dl>","2":"<div class=\"phase-meta\"><span class=\"phase-num\">02</span><span class=\"phase-dur\">4–6 weken</span></div>\n      <h2>Netpositie en transportrecht</h2>\n      <p>De batterij laadt uit het park binnen het bestaande transportrecht, dus er is geen nieuwe aansluiting nodig. Dat is het hele punt van co-locatie en het scheelt jaren wachttijd. Wel moet de MLOEA goed staan, anders raakt het park zijn SDE-beschikking op de opgeslagen energie kwijt.</p>\n      <dl class=\"role\"><dt>Gridstate</dt><dd>Netcheck op beide knelpuntlagen, afstemming met de netbeheerder, en de MLOEA zodat de beschikking intact blijft.</dd></dl>","3":"<div class=\"phase-meta\"><span class=\"phase-num\">03</span><span class=\"phase-dur\">3–5 maanden</span></div>\n      <h2>Vergunning en engineering</h2>\n      <p>Staat de batterij als ondergeschikte functie bij het park, dan loopt de vergunning via de korte route in plaats van een volledige buitenplanse afwijking. Het ontwerp gaat parallel: layout binnen de veiligheidsafstanden van PGS 37-1, single-line, beveiligingsconcept en de koppeling op het bestaande inkoopstation.</p>\n      <dl class=\"role\"><dt>Gridstate</dt><dd>Volledig ontwerp en vergunningsdossier, extern gestempeld door een onafhankelijke engineeringpartij.</dd></dl>","4":"<div class=\"phase-meta\"><span class=\"phase-num\">04</span><span class=\"phase-dur\">10–18 weken</span></div>\n      <h2>Inkoop en fabriekstest</h2>\n      <p>Vier containers en een conversiestation. De order gaat pas de deur uit na verlening van de vergunning, met de specificatie en het orderpakket vooraf klaar zodat er in de week van verlening besteld kan worden.</p>\n      <dl class=\"role\"><dt>Gridstate</dt><dd>Inkoop onder open book, en inspectie van elk systeem in de fabriek voor verzending.</dd></dl>","5":"<div class=\"phase-meta\"><span class=\"phase-num\">05</span><span class=\"phase-dur\">3–4 weken</span></div>\n      <h2>Civiel en infrastructuur</h2>\n      <p>Een compact terreindeel naast het bestaande inkoopstation: fundaties, hekwerk, kabeltracé en de opstelplaats voor de brandweer. Het park blijft gewoon produceren tijdens de bouw, dus de werkzaamheden worden ingepland rond de productie.</p>\n      <dl class=\"role\"><dt>Gridstate</dt><dd>Aanbesteding en regie op de civiele aannemer, en de afstemming met de exploitant over werken naast een draaiend park.</dd></dl>","6":"<div class=\"phase-meta\"><span class=\"phase-num\">06</span><span class=\"phase-dur\">1–2 weken</span></div>\n      <h2>Plaatsing</h2>\n      <p>Vier units van 20 voet, twee bij twee en gespiegeld, samen 20 MWh. Op deze schaal staat alles binnen een week, mits het terrein klaar ligt en de kraan kan komen waar hij moet zijn.</p>\n      <dl class=\"role\"><dt>Gridstate</dt><dd>Ontvangst, plaatsing volgens hijsplan en de mechanische afmontage.</dd></dl>","7":"<div class=\"phase-meta\"><span class=\"phase-num\">07</span><span class=\"phase-dur\">2 weken</span></div>\n      <h2>Koppeling op het bestaande station</h2>\n      <p>Het conversiestation van 40 voet en de middenspanningskabel naar het inkoopstation van het park. Dat is een kort tracé, en het bestaat alleen omdat het park er al ligt. Precies daar zit het kostenvoordeel van co-locatie.</p>\n      <dl class=\"role\"><dt>Gridstate</dt><dd>Plaatsing van het station, de gelijkstroomkoppeling en de aansluiting op het bestaande inkoopstation.</dd></dl>","8":"<div class=\"phase-meta\"><span class=\"phase-num\">08</span><span class=\"phase-dur\">2–4 weken</span></div>\n      <h2>Inbedrijfstelling</h2>\n      <p>Site acceptance test, celbalancering, netcodetest en de koppeling van het regelsysteem aan de aggregator. De sturing moet weten wat het park doet, want laden gebeurt binnen de ruimte die de zon overlaat.</p>\n      <dl class=\"role\"><dt>Gridstate</dt><dd>SAT-protocol, netcodevalidatie en de configuratie van de sturing samen met de exploitant van het park.</dd></dl>","9":"<div class=\"phase-meta\"><span class=\"phase-num\">09</span><span class=\"phase-dur\">Vanaf COD</span></div>\n      <h2>Op de markt</h2>\n      <p>Vanaf hier vangt de batterij de uren op waarin het park anders was afgeregeld, en draait daarnaast op FCR, aFRR en onbalans. Doorlooptijd van eerste gesprek tot oplevering: ongeveer een jaar, en dat is de helft van wat een standalone park kost aan tijd.</p>\n      <dl class=\"role\"><dt>Gridstate</dt><dd>Monitoring, performance reporting en jaarlijkse hervalidatie. Onderhoud via onze partners.</dd></dl>"},"data":{"1":[8.4,"MWp zon",0,"MWh",0,"van 5","Afregeling bij piek",0],"2":[5,"MW ontwerp",20,"MWh ontwerp",0,"van 5","Transportrecht bevestigd",0],"3":[5,"MW ontwerp",20,"MWh ontwerp",0,"van 5","Vergunning in procedure",0],"4":[5,"MW besteld",20,"MWh besteld",0,"van 5","In productie",0],"5":[5,"MW",20,"MWh",0,"van 5","Terrein gereed",0],"6":[5,"MW",20,"MWh",4,"van 5","Containers geplaatst",0],"7":[5,"MW",20,"MWh",5,"van 5","Aangesloten",0],"8":[5,"MW",20,"MWh",5,"van 5","Netcodetest",0],"9":[5,"MW",20,"MWh",5,"van 5","Live op de markt",1]}}